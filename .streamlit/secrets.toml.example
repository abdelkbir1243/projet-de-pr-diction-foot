# Copier ce fichier en .streamlit/secrets.toml (local, jamais versionné) ou coller ces lignes dans
# Streamlit Cloud → Settings → Secrets. Tous les secrets sont facultatifs.

# Calendrier officiel et scores en direct — clé gratuite : https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY = ""

# Assistant rédigé par Claude (sinon moteur local gratuit)
ANTHROPIC_API_KEY = ""

# "0" = ne jamais recalculer dans l'application (se contenter de web/data publié par GitHub Actions)
GOALGEBRA_MAJ_AUTO = "1"
