# Copier en deploy/.env puis remplir. Ce fichier contient des secrets : ne jamais le versionner (déjà dans .gitignore).

# ---- noms de domaine (enregistrements DNS A/AAAA pointant vers l'adresse IP du serveur)
DOMAINE=goalgebra.example.org
DOMAINE_API=api.goalgebra.example.org
EMAIL_ACME=toi@example.org                 # contact Let's Encrypt (expiration des certificats)
API_URL_PUBLIQUE=https://api.goalgebra.example.org

# ---- base de données (générer : openssl rand -base64 32 | tr -d '/+=')
POSTGRES_PASSWORD=change-moi

# ---- premier administrateur (créé au démarrage du worker ; changer le mot de passe ensuite dans « Mon compte »)
ADMIN_EMAIL=toi@example.org
ADMIN_PASSWORD=change-moi-aussi-1234

# ---- comptes et accès
INSCRIPTIONS_OUVERTES=1                    # 0 = seuls les comptes créés par un administrateur
PLATEFORME_PRIVEE=0                        # 1 = toute l'application exige une connexion
COOKIE_SECURE=1
API_QUOTA_JOUR=1000                        # requêtes par jour et par clé
API_LIMITE_MINUTE=60                       # requêtes par minute et par clé

# ---- données et calcul
INTERVALLE_MIN=120                         # fréquence du calcul (minutes)
FOOTBALL_DATA_API_KEY=                     # facultatif : scores en direct (football-data.org, clé gratuite)
ALERTE_WEBHOOK=                            # facultatif : URL Discord / Slack / ntfy pour les alertes d'échec ou de retard
SAUVEGARDE_JOURS=14                        # durée de conservation des sauvegardes quotidiennes

# ---- assistant (facultatif)
ANTHROPIC_API_KEY=
